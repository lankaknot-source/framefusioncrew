rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    match /framefusion_crew/{document=**} {
      allow read, write: if signedIn();
    }
    match /framefusion_projects/{document=**} {
      allow read, write: if signedIn();
    }
    match /framefusion_signatures/{document=**} {
      allow read, write: if signedIn();
    }
    match /framefusion_receipts/{document=**} {
      allow read, write: if signedIn();
    }
    match /framefusion_settings/{document=**} {
      allow read, write: if signedIn();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
